{
  "atomCode": "junit-report",
  "name": "JUnit test report",
  "version": "1.1.0",
  "description": "Summarises the JUnit XML a build produced and publishes it as an HTML report on the build page.",
  "execution": {
    "packagePath": "junit-report.jar",
    "language": "java",
    "target": "$atom_java_path -cp junit-report.jar com.jenkinschina.atom.sdk.AtomRunner"
  },
  "input": {
    "testResults": {
      "label": "测试报告 XML（glob，逗号分隔）",
      "type": "vuex-input",
      "default": "**/surefire-reports/*.xml"
    },
    "label": {
      "label": "报告名称",
      "type": "vuex-input",
      "default": "Test results"
    },
    "outputDir": {
      "label": "生成的 HTML 放哪里",
      "type": "vuex-input",
      "default": "out/junit"
    },
    "allowEmptyResults": {
      "label": "没有匹配到报告不算失败",
      "type": "checkbox",
      "default": "false"
    },
    "skipMarkingUnstable": {
      "label": "有失败用例时不把构建标为 UNSTABLE",
      "type": "checkbox",
      "default": "false"
    },
    "failOnFailure": {
      "label": "有失败用例就让这一步失败（比 UNSTABLE 更强）",
      "type": "checkbox",
      "default": "false"
    }
  },
  "output": {
    "total": {
      "type": "string",
      "description": "用例总数"
    },
    "failed": {
      "type": "string",
      "description": "失败数"
    },
    "errors": {
      "type": "string",
      "description": "错误数"
    },
    "skipped": {
      "type": "string",
      "description": "跳过数"
    },
    "durationSeconds": {
      "type": "string",
      "description": "用例耗时合计（秒）"
    },
    "report": {
      "type": "report",
      "description": "构建页内嵌的 HTML 报告"
    },
    "buildResult": {
      "type": "string",
      "description": "请求的构建结果（UNSTABLE 时由 runner 施加）"
    }
  },
  "x-jenkins": {
    "protocol": "jenkins-1",
    "requires": {
      "runner": ">=0.4.0"
    }
  }
}
